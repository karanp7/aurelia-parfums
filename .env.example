# Shopify Storefront API — Headless storefront
#
# In Vercel: Project Settings -> Environment Variables. Locally: copy this
# file to .env.local (gitignored) and fill in real values.
#
# Both variables MUST use the VITE_ prefix — Vite only exposes VITE_-prefixed
# env vars to browser/client code. If your existing Vercel env vars use
# different names, either rename them to match these or update
# src/lib/shopify.js to match your names.

# Your *.myshopify.com domain (not a custom domain), e.g. aurelia-parfums.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=

# Storefront API public access token (Headless channel -> Storefront API
# client, or a custom app's Storefront API access token). This is the public
# token meant to ship in client code — never use an Admin API token here.
VITE_SHOPIFY_STOREFRONT_TOKEN=
