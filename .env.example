# Shopify Storefront API — Headless storefront
#
# In Vercel: Project Settings -> Environment Variables. Locally: copy this
# file to .env.local (gitignored) and fill in real values.
#
# These deliberately do NOT use Vite's VITE_ prefix (matching how they're
# already named in Vercel). vite.config.js explicitly inlines just these two
# into the client bundle via `define` - see src/lib/shopify.js.

# Your *.myshopify.com domain (not a custom domain), e.g. aurelia-parfums.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API PUBLIC access token (Headless channel -> Storefront API
# client, or a custom app's Storefront API access token). This is the public
# token meant to ship in client code.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# If you also have SHOPIFY_STOREFRONT_PRIVATE_TOKEN set in Vercel: leave it
# alone. It is never read by this app. A private Storefront API token must
# never be exposed to client-side code - only SHOPIFY_STOREFRONT_ACCESS_TOKEN
# (the public one) belongs here.
